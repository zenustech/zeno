# Embed the small FAST masks, without a runtime source-tree or working-directory dependency.
function(zeno_embed_fast_sampling_data target)
    set(data_dir "${CMAKE_CURRENT_SOURCE_DIR}/sampling/fast")
    foreach(kind IN ITEMS scalar vector2)
        if(kind STREQUAL "scalar")
            set(symbol fastScalar)
            set(expected_bytes 524288)
        else()
            set(symbol fastVector2)
            set(expected_bytes 1048576)
        endif()
        set(input "${data_dir}/fast-${kind}.u8")
        set(output "${CMAKE_CURRENT_BINARY_DIR}/FastSampling-${kind}.cpp")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${input}")
        file(SIZE "${input}" size)
        if(NOT size EQUAL expected_bytes)
            message(FATAL_ERROR "Invalid FAST ${kind} mask size: ${size}")
        endif()
        file(SHA256 "${input}" hash)
        set(previous_hash "")
        if(EXISTS "${output}.sha256")
            file(READ "${output}.sha256" previous_hash)
        endif()
        if(NOT EXISTS "${output}" OR NOT "${hash}" STREQUAL "${previous_hash}")
            file(READ "${input}" contents HEX)
            # Sixteen bytes per line keeps generated compiler input manageable.
            string(REGEX REPLACE "(................................)" "\\1\n" contents "${contents}")
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," contents "${contents}")
            file(WRITE "${output}" "// Generated from sampling/fast; see its LICENSE.txt.\n#include \"PathSamplingData.h\"\nnamespace zeno_path_sampling {\nconst unsigned char ${symbol}[] = {\n${contents}\n};\n}\n")
            file(WRITE "${output}.sha256" "${hash}")
        endif()
        target_sources(${target} PRIVATE "${output}")
    endforeach()
    if(CMAKE_RUNTIME_OUTPUT_DIRECTORY)
        file(MAKE_DIRECTORY "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/licenses")
        configure_file("${data_dir}/LICENSE.txt"
            "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}/licenses/fastnoise.txt" COPYONLY)
    endif()
    install(FILES "${data_dir}/LICENSE.txt" DESTINATION share/licenses/zeno RENAME fastnoise.txt)
endfunction()
