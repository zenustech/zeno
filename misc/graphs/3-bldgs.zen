            "PyFixMatNames": {
                "name": "PyFixMatNames",
                "class": "PythonNode",
                "object_inputs": {
                    "object": {
                        "links": [
                            {
                                "out-node": "PrimsFilterInUserdata1",
                                "out-socket": "out",
                                "out-key": "",
                                "in-key": "",
                                "target-socket": ""
                            }
                        ],
                        "type": "iobject",
                        "socket-type": "clone"
                    }
                },
                "primitive_inputs": {
                    "script": {
                        "links": null,
                        "type": "string",
                        "default-value": "import zen\r\ngra = zen.mainGraph()\r\nobj = gra.getInputObject(\"PyFixMatNames\", \"object\")\r\nlst = obj.toList()\r\nfor matObj in lst:\r\n    matNum = matObj.getUserData(\"matNum\")\r\n    for i in range(matNum):\r\n        key = \"Material_%d\" % i\r\n        matName = matObj.getUserData(key)\r\n        matName = matName.replace(' ','_')\r\n        matObj.setUserData(key, matName)",
                        "control": {
                            "name": "CodeEditor"
                        },
                        "socket-type": "clone",
                        "visible": false
                    }
                },
                "primitive_outputs": {},
                "object_outputs": {
                    "object": {
                        "type": "iobject",
                        "socket-type": "output"
                    }
                },
                "uipos": [
                    -2083.0,
                    4071.0
                ],
                "status": [],
                "collasped": false
            },
